{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/task.schema.json",
  "title": "UASEP Task Contract",
  "type": "object",
  "required": ["id", "objective", "owner", "branch", "write_set", "dependencies", "conflicts", "acceptance", "risk", "verification", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "branch": {"type": "string", "minLength": 1},
    "write_set": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "verification": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "status": {"enum": ["READY", "IN_PROGRESS", "BLOCKED", "UNKNOWN", "PARTIALLY_VERIFIED", "VERIFIED", "FAILED", "DONE"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"}
  },
  "additionalProperties": false
}
