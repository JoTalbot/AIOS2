{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoTalbot/UASEP/schemas/evidence.schema.json",
  "title": "UASEP Evidence",
  "type": "object",
  "required": ["evidence_id", "task_id", "timestamp", "agent", "operation", "scope", "result", "source", "observed"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "result": {"enum": ["VERIFIED", "PARTIALLY_VERIFIED", "UNKNOWN", "FAILED"]},
    "source": {"type": "string", "minLength": 1},
    "observed": {"type": "string", "minLength": 1},
    "commit": {"type": ["string", "null"]},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": ["string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "related": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
